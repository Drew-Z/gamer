# Server-only configuration. Copy to .env.local on each server and fill values there.
# index.js and npm run migrate:community-db load .env.local automatically.
# Never commit .env.local.

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Optional. Supabase pooler hosts are inferred as require if this is omitted.
# POSTGRES_SSLMODE=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=pet-assets
GA_PET_SYNC_SUPABASE=1

# HidenCloud/community-api:
# FANTASY_PET_API_BASE_URL=https://AGENT_API_HOST
# FANTASY_PET_UPSTREAM_TOKEN=REPLACE_WITH_SERVER_SIDE_AGENT_DEMO_TOKEN
# COMMUNITY_DEMO_TOKEN=REPLACE_WITH_ANDROID_DEMO_TOKEN
# Private ops Docker Compose. Use URL-safe values for the compose-generated
# DATABASE_URL, or set DATABASE_URL directly for managed PostgreSQL hosts.
# COMMUNITY_POSTGRES_DB=gamer
# COMMUNITY_POSTGRES_USER=gamer
# COMMUNITY_POSTGRES_PASSWORD=REPLACE_WITH_PRIVATE_POSTGRES_PASSWORD
# COMMUNITY_BASE_URL=http://127.0.0.1:4000
# PRIVATE_OPS_CREATE_JOB=0
# Optional public API protection. Disabled unless COMMUNITY_RATE_LIMIT_ENABLED is true.
# COMMUNITY_RATE_LIMIT_ENABLED=0
# COMMUNITY_RATE_LIMIT_WINDOW_MS=60000
# COMMUNITY_RATE_LIMIT_WRITE_MAX=4
# COMMUNITY_RATE_LIMIT_READ_MAX=60

# GA random pet worker/admin review:
# GA_PET_API_PROVIDER=l0veyou
# GA_PET_API_BASE_URL=https://l0veyou.com
# GA_PET_API_KEY=REPLACE_ME
# GA_PET_IMAGE_MODEL=nano-banana-2
# GA_PET_VIDEO_MODEL=ltx-video
# GA_PET_RUN_ROOT=/data/ga-random-pets
# GA_PET_PACKAGE_MODE=full
# GA_PET_QUALITY_PRESET=high
# GA_PET_IMAGE_SIZE=2K
# GA_PET_SPRITESHEET_IMAGE_SIZE=4K
# GA_PET_BACKGROUND_MODE=transparent
# GA_PET_OUTPUT_MIME_TYPE=image/png
# GA_PET_ENABLE_VIDEO=1
# GA_PET_REWORK_STARTED_TIMEOUT_MINUTES=180
