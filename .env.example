# Server-only configuration. Copy to .env.local on each server and fill values there.
# index.js and npm run migrate:community-db load .env.local automatically.
# Never commit .env.local.

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres
# Optional. Supabase pooler hosts are inferred as require if this is omitted.
# POSTGRES_SSLMODE=require
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_REPLACE_ME
SUPABASE_STORAGE_BUCKET=pet-assets

# HidenCloud/community-api:
# FANTASY_PET_API_BASE_URL=http://120.48.67.110:8765

# GA random pet worker/admin review:
# GA_PET_RUN_ROOT=/data/ga-random-pets
# GA_PET_PACKAGE_MODE=full
# GA_PET_QUALITY_PRESET=high
# GA_PET_IMAGE_SIZE=2K
# GA_PET_SPRITESHEET_IMAGE_SIZE=4K
# GA_PET_BACKGROUND_MODE=transparent
# GA_PET_OUTPUT_MIME_TYPE=image/png
# GA_PET_REWORK_STARTED_TIMEOUT_MINUTES=180
