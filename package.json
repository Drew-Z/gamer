{
  "name": "gamer",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"apps/**/*.test.js\" \"packages/**/*.test.js\" \"services/**/*.test.js\" \"tools/**/*.test.js\"",
    "start:admin-review": "node apps/admin-review/server.js",
    "start:community-api": "node services/community-api/src/server.js",
    "start:pet-generator": "node services/pet-generator/src/server.js",
    "check:ga-random-pet-worker": "node services/pet-generator/src/ga-random-pet-worker.js --config-check",
    "start:ga-random-pet-worker": "node services/pet-generator/src/ga-random-pet-worker.js",
    "migrate:community-db": "node services/community-api/src/database/migrate.js",
    "migrate:community-db:dry-run": "node services/community-api/src/database/migrate.js --dry-run",
    "smoke:private-ops": "node tools/private-ops-smoke.js"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22"
  }
}
