# Copy to .env.private-ops on the private VM. Keep real values out of git.

COMMUNITY_BASE_URL=https://desktop-pet.example.internal
# combined runs Community and Agent in one compose project.
# hiden Community API should use:
# PRIVATE_OPS_DEPLOYMENT_ROLE=community
# FANTASY_PET_API_BASE_URL=https://<baidu-agent-private-url>
PRIVATE_OPS_DEPLOYMENT_ROLE=combined
FANTASY_PET_API_BASE_URL=http://fantasy-pet-api:8765
PRIVATE_OPS_HOST=desktop-pet.example.internal
PRIVATE_OPS_TLS_MODE=internal
PRIVATE_OPS_ADMIN_USER=operator
# If a generated bcrypt hash is stored in this Compose env file, escape each
# dollar sign as $$ so Docker Compose does not treat hash fragments as variables.
CADDY_ADMIN_BASIC_AUTH_HASH=REPLACE_WITH_CADDY_HASHED_PASSWORD
COMMUNITY_CORS_ALLOWED_ORIGINS=https://desktop-pet.example.internal
# Defaults to COMMUNITY_CORS_ALLOWED_ORIGINS when blank. Keep explicit if the
# browser-facing admin-review host differs from other allowed Community origins.
COMMUNITY_ADMIN_REVIEW_TRUSTED_ORIGINS=https://desktop-pet.example.internal

COMMUNITY_POSTGRES_DB=gamer
COMMUNITY_POSTGRES_USER=gamer
COMMUNITY_POSTGRES_PASSWORD=REPLACE_WITH_URL_SAFE_PRIVATE_POSTGRES_PASSWORD

COMMUNITY_DEMO_TOKEN=REPLACE_WITH_PRIVATE_COMMUNITY_DEMO_TOKEN
FANTASY_PET_UPSTREAM_TOKEN=REPLACE_WITH_PRIVATE_AGENT_DEMO_TOKEN
FANTASY_PET_ADAPTER_CONFIG_FILE=../fantasy-pet-rule/config/adapter-config.server.example.json

COMMUNITY_RATE_LIMIT_ENABLED=1
COMMUNITY_RATE_LIMIT_WINDOW_MS=60000
COMMUNITY_RATE_LIMIT_WRITE_MAX=4
COMMUNITY_RATE_LIMIT_READ_MAX=60

FANTASY_PET_DEMO_MAX_ACTIVE_JOBS=1
FANTASY_PET_DEMO_HOURLY_CREATE_LIMIT=4
FANTASY_PET_DEMO_DAILY_CREATE_LIMIT=12
FANTASY_PET_RUN_RETENTION_DAYS=14
# Optional synthetic probe for a human-reviewed known job package gate.
# The package endpoint may return a ready ZIP or a stable gated JSON response.
PRIVATE_OPS_KNOWN_APP_JOB_ID=

# Optional: lets tools/private-ops-smoke.js authenticate through Caddy Basic Auth.
PRIVATE_OPS_BASIC_AUTH_USER=operator
PRIVATE_OPS_BASIC_AUTH_PASSWORD=REPLACE_WITH_PRIVATE_BASIC_AUTH_PASSWORD
