{
	admin off
}

{$PRIVATE_OPS_HOST:localhost} {
	tls {$PRIVATE_OPS_TLS_MODE:internal}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
	}

	basic_auth {
		{$PRIVATE_OPS_ADMIN_USER:operator} {$CADDY_ADMIN_BASIC_AUTH_HASH}
	}

	reverse_proxy admin-review:4200
}
