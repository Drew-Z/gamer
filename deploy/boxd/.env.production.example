# Copy this file to deploy/boxd/.env.production on the Boxd VM.
# Fill real values on the server only. Do not commit real secrets.

# Public service ports inside Docker.
COMMUNITY_API_PORT=4000
ADMIN_REVIEW_PORT=4200

# Cloudflare Tunnel token from Cloudflare Zero Trust.
CLOUDFLARED_TOKEN=

# Aiven PostgreSQL primary or PgBouncer service URI.
DATABASE_URL=
AIVEN_CA_CERT_PATH=/run/secrets/aiven-ca.pem

# External fantasy-pet public app API. This is not an admin or worker URL.
FANTASY_PET_API_BASE_URL=

# Cloudflare R2 object storage for candidate previews, pet.zip, and showcase assets.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=gamer-pet-assets
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=

# Android production API targets used at build time when producing an APK.
ANDROID_COMMUNITY_API_BASE_URL=
ANDROID_FANTASY_PET_API_BASE_URL=
